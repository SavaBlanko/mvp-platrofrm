{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "CACHE EFFECTIVENESS",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache Hit Ratio",
      "description": "Share of cache lookups served by cache.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_requests_total{result=\"hit\"}[$__rate_interval])) / sum(rate(cache_requests_total[$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Estimated DB Read Load Saved",
      "description": "1 - DB query rate / cache lookup rate. Use during the cache-aside test window.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(rate(db_query_duration_seconds_count{operation=\"get_product\"}[$__rate_interval])) / sum(rate(cache_requests_total[$__rate_interval])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HTTP p50 Latency \u0394",
      "description": "(cache / DB-only) - 1. Negative = cache faster; positive = cache slower.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.50,sum by(le)(rate(http_request_duration_seconds_bucket{cache=\"true\"}[$__rate_interval]))) / histogram_quantile(0.50,sum by(le)(rate(http_request_duration_seconds_bucket{cache=\"false\"}[$__rate_interval])))-1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "HTTP p95 Latency \u0394",
      "description": "(cache / DB-only) - 1. Negative = cache faster; positive = cache slower.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95,sum by(le)(rate(http_request_duration_seconds_bucket{cache=\"true\"}[$__rate_interval]))) / histogram_quantile(0.95,sum by(le)(rate(http_request_duration_seconds_bucket{cache=\"false\"}[$__rate_interval])))-1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Latency \u2014 Cache vs DB-only",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50,sum by(le,cache)(rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "cache={{cache}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by(le,cache)(rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "cache={{cache}} p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99,sum by(le,cache)(rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "cache={{cache}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DB Queries vs Cache Lookups",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_requests_total[$__rate_interval]))",
          "legendFormat": "cache lookups"
        },
        {
          "refId": "B",
          "expr": "sum(rate(db_query_duration_seconds_count{operation=\"get_product\"}[$__rate_interval]))",
          "legendFormat": "DB queries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
